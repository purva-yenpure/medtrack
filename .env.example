# ==============================================================================
# MedTrack Environment Configuration
# ==============================================================================

# Mode Selection: 'auto' (detects AWS credentials automatically, falls back to local if none found)
# You can also explicitly set 'true' to force AWS, or 'false' to force local.
USE_AWS=auto

# Secret Key for Flask Session Cookies
SECRET_KEY=medtrack-super-secret-key-prod-2026

# AWS Region & Temporary Credentials (e.g. from Troven Labs 3-hour access)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# DynamoDB Table Names
DYNAMODB_TABLE_USERS=MedTrack_Users
DYNAMODB_TABLE_DOCTORS=MedTrack_Doctors
DYNAMODB_TABLE_PATIENTS=MedTrack_Patients
DYNAMODB_TABLE_APPOINTMENTS=MedTrack_Appointments
DYNAMODB_TABLE_DIAGNOSIS=MedTrack_Diagnosis
DYNAMODB_TABLE_NOTIFICATIONS=MedTrack_Notifications

# AWS SNS Topic ARN (Populated after running create_tables.py)
SNS_TOPIC_ARN=

# Optional SMTP Email Service (e.g., Gmail, Yahoo)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
