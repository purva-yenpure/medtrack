# =============================================================================
# MedTrack .gitignore (Python Flask + React / Vite + AWS)
# =============================================================================

# --- Environment & Security (NEVER COMMIT AWS KEYS) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Local Databases & Data Store ---
local_db.json
*.db
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node.js & React (Vite) ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- OS Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Logs ---
*.log
logs/
